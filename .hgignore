syntax: glob
wayback/download.log
wayback/download.pid
wayback/retry.txt
lisper.conf
download.pid
syntax: regexp
# NOTE: a bare "build/" glob in this file also matched prod/build (the deploy
# script) and hg silently refused to track it — hence the anchored regexp below.
^build/
^data/
^static/
^wayback/site/
