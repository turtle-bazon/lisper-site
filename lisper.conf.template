(:address "0.0.0.0"
 :port 8080
 :log-level :info
 :db-host "127.0.0.1"
 :db-port 5432
 :db-name "lisper"
 :db-user "lisper"
 :db-password "lisper"
 :geo-db-path "/path/to/GeoLite2-Country.mmdb"
 :admin-secret "change-me-random-hex"
 ;; Секрет HMAC подписей антиспам-токенов форм (регистрация/логин);
 ;; если не задан — используется admin-secret
 :form-secret "change-me-another-random-hex"
 ;; Токен API /regexp-game (Authorization: Bearer <token>);
 ;; если не задан — используется встроенный дефолт
 :game-token "change-me-game-token"
  ;; Канонический URL сайта (для canonical/sitemap/OG/RSS).
  ;; Используется как fallback, когда Host запроса не в списке :site-hosts.
  :site-url "http://lisper.ru"
  ;; Домены, для которых абсолютные URL (canonical/hreflang/og:url/RSS/
  ;; sitemap) строятся от ТЕКУЩЕГО запроса, а не от :site-url. Host вне
  ;; этого списка игнорируется — иначе краулер с чужим Host подмешал бы свой
  ;; домен в canonical. Не задано = режим одного домена (только :site-url).
  :site-hosts ("lisper.ru" "lisper.nl"))