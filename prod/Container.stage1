# =============================================================================
# Stage 1 — build the CL binary inside turtlebazon/bazon-lisp-dev
# =============================================================================
# Unlike link-short, lisper NEEDS node at build time: build-resources.lisp
# compiles jscl-tools/*.lisp and jscl-games/*.lisp into JS bundles with the
# vendored jscl/jscl-node.js and embeds them in src/jscl-bundles.lisp. Without
# node the build "succeeds" with an empty table (REQUIRE_NODE=1 turns that into
# a hard error), so nodejs is installed here. It never reaches the runtime
# image — only the extracted binary is copied into stage 2.
#
# Base image is pinned (bazon-lisp-dev:2.6.9 == SBCL 2.6.9) instead of
# :latest, so a rebuild months from now uses the same compiler. Fully qualified
# with docker.io on purpose: short-name resolution is not configured here, and
# an unqualified FROM only works when the image already happens to be local.
FROM docker.io/turtlebazon/bazon-lisp-dev:2.6.9

ARG BUILD_SUFFIX=

RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs \
    && rm -rf /var/lib/apt/lists/*

# The image bakes in a quicklisp snapshot (ARG QUICKLISP_DIST), so its dists
# are frozen at image-build time while the dist we publish to keeps moving —
# cl-schema-20261016 postdates this image's bazon-public 202624090652, and
# build.lisp only does ql:quickload, which never refreshes a dist. Without
# this the build dies with `System "cl-schema" not found`.
#
# ALL dists, not just bazon-public: the same staleness can hit any dependency.
# :prompt nil is required — update-all-dists' PROMPT defaults to T and would
# block the build waiting on stdin. (It is ql:update-all-dists; there is no
# ql-dist:update-all-dists.)
#
# Deliberately placed BEFORE the COPYs: source edits then reuse this cached
# layer, so dists only refresh when the base image or this file changes.
RUN sbcl --non-interactive \
    --eval '(ql:update-all-dists :prompt nil)'

WORKDIR /app-build

COPY lisper.asd build.lisp build-resources.lisp Makefile ./
COPY src/ ./src/
COPY migrations/ ./migrations/
COPY resources/ ./resources/
COPY jscl/ ./jscl/
COPY jscl-tools/ ./jscl-tools/
COPY jscl-games/ ./jscl-games/

# container-build = clean + prepare + embed-resources (sbcl, needs node above)
# + build.lisp. No pkill (nothing of ours runs in the builder) and no host
# processes. Output: build/lisper$BUILD_SUFFIX.
RUN REQUIRE_NODE=1 BUILD_SUFFIX=$BUILD_SUFFIX make container-build
