t;&gt;name &lt;span class=&quot;paren4&quot;&gt;(&lt;span class=&quot;&quot;&gt;#&#039;&lt;a href=&quot;http://www.lispworks.com/reference/HyperSpec/Body/f_parse_.htm&quot; class=&quot;symbol&quot;&gt;parse-integer&lt;/a&gt; index&lt;/span&gt;)&lt;/span&gt;&lt;/span&gt;)&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span class=&quot;paren3&quot;&gt;(&lt;span class=&quot;&quot;&gt;&lt;span class=&quot;string&quot;&gt;&quot;^&lt;/span&gt;&lt;span class=&quot;string&quot;&gt;\\&lt;/span&gt;&lt;span class=&quot;string&quot;&gt;s*Тип ошибки:&lt;/span&gt;&lt;span class=&quot;string&quot;&gt;\\&lt;/span&gt;&lt;span class=&quot;string&quot;&gt;s*(&lt;/span&gt;&lt;span class=&quot;string&quot;&gt;\\&lt;/span&gt;&lt;span class=&quot;string&quot;&gt;S.+&lt;/span&gt;&lt;span class=&quot;string&quot;&gt;\\&lt;/span&gt;&lt;span class=&quot;string&quot;&gt;S)&lt;/span&gt;&lt;span class=&quot;string&quot;&gt;\\&lt;/span&gt;&lt;span class=&quot;string&quot;&gt;s*-&lt;/span&gt;&lt;span class=&quot;string&quot;&gt;\\&lt;/span&gt;&lt;span class=&quot;string&quot;&gt;s*(&lt;/span&gt;&lt;span class=&quot;string&quot;&gt;\\&lt;/span&gt;&lt;span class=&quot;string&quot;&gt;d+)$&quot;&lt;/span&gt; txt&lt;/span&gt;)&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span class=&quot;paren3&quot;&gt;(&lt;span class=&quot;&quot;&gt;&lt;a href=&quot;http://www.lispworks.com/reference/HyperSpec/Body/a_list.htm&quot; class=&quot;symbol&quot;&gt;list&lt;/a&gt; name index&lt;/span&gt;)&lt;/span&gt;&lt;/span&gt;)&lt;/span&gt;&lt;/span&gt;)&lt;/span&gt;&lt;br&gt;
