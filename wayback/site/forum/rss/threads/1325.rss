&lt;span class=""&gt;log-msg &lt;span class="string"&gt;"test3 : ~a"&lt;/span&gt; hwnd&lt;/span&gt;)&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span class="paren3"&gt;(&lt;span class=""&gt;when &lt;span class="paren4"&gt;(&lt;span class=""&gt;null-pointer-p hwnd&lt;/span&gt;)&lt;/span&gt; &lt;span class="paren4"&gt;(&lt;span class=""&gt;&lt;i&gt;&lt;span class="symbol"&gt;return-from&lt;/span&gt;&lt;/i&gt; create-gl-context nil&lt;/span&gt;)&lt;/span&gt;&lt;/span&gt;)&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span class="paren3"&gt;(&lt;span class=""&gt;setf &lt;span class="special"&gt;*hdc*&lt;/span&gt; &lt;span class="paren4"&gt;(&lt;span class=""&gt;glop-win32:get-dc hwnd&lt;/span&gt;)&lt;/span&gt;&lt;/span&gt;)&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span class="paren3"&gt;(&lt;span class=""&gt;when &lt;span class="paren4"&gt;(&lt;span class=""&gt;null-pointer-p &lt;span class="special"&gt;*hdc*&lt;/span&gt;&lt;/span&gt;)&lt;/span&gt; &lt;span class="paren4"&gt;(&lt;span class=""&gt;&lt;i&gt;&lt;span class="symbol"&gt;return-from&lt;/span&gt;&lt;/i&gt; create-gl-context nil&lt;/span&gt;)&lt;/span&gt;&lt;/span&gt;)&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span class="paren3"&gt;(&lt;span class=""&gt;glop-win32:choose-pixel-format &lt;span class="special"&gt;*hdc*&lt;/span&gt;&lt;/span&gt;)&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span class="paren3"&gt;(&lt;span class=""&gt;&lt;i&gt;&lt;span class="symbol"&gt;let&lt;/span&gt;&lt;/i&gt; &lt;span class="paren4"&gt;(&lt;span class=""&gt;&lt;span class="paren5"&gt;(&lt;span class=""&gt;gl-context &lt;span class="paren6"&gt;(&lt;span class=""&gt;glop-wgl:wgl-create-context &lt;span class="special"&gt;*hdc*&lt;/span&gt;&lt;/span&gt;)&lt;/span&gt;&lt;/span&gt;)&lt;/span&gt;&lt;/span&gt;)&lt;/span&gt;&